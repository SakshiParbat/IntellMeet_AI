# IntellMeet Backend - Environment Variables
# Isko copy karke .env naam se save karein

# ─── SERVER ───
PORT=5000
NODE_ENV=development

# ─── DATABASE ───
MONGODB_URI=mongodb://localhost:27017/intellmeet
# Production ke liye MongoDB Atlas URI use karein:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/intellmeet

# ─── JWT SECRETS (Strong random strings use karein!) ───
JWT_SECRET=apna_super_secret_jwt_key_yahaan_daalein_minimum_32_chars
JWT_REFRESH_SECRET=apna_refresh_token_secret_yahaan_daalein_different_from_above

# ─── CLIENT URL (CORS ke liye) ───
CLIENT_URL=http://localhost:5173

# ─── OPENAI (AI Features ke liye) ───
OPENAI_API_KEY=sk-your_openai_api_key_here

# ─── CLOUDINARY (Profile/Recording upload ke liye) ───
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── REDIS (Caching ke liye - Optional) ───
REDIS_URL=redis://localhost:6379
